<service>
  <id>VocabTunnel</id>
  <name>Vocab App - Cloudflare Tunnel</name>
  <description>Cloudflare quick tunnel, expose VocabApp (localhost:8899) ra internet.</description>

  <executable>C:\Program Files (x86)\cloudflared\cloudflared.exe</executable>
  <arguments>tunnel --url http://localhost:8899</arguments>

  <workingdirectory>c:\Users\Admin\Desktop\project\vocab</workingdirectory>

  <startmode>Automatic</startmode>
  <!-- KHÔNG dùng <depend>VocabApp</depend>: Windows SCM sẽ cascade-stop VocabTunnel mỗi khi
       VocabApp bị stop (vd. mỗi lần build.bat redeploy) — nhưng build.bat chỉ start lại
       VocabApp, không start lại VocabTunnel, nên tunnel bị "chết" sau mỗi lần build.
       cloudflared tự retry kết nối tới localhost:8899 khi chưa sẵn sàng, không cần
       dependency cứng để chạy đúng thứ tự lúc boot. -->



  <!-- mode="reset": xoá sạch log cũ mỗi lần service start lại, không giữ lịch sử. -->
  <logpath>c:\Users\Admin\Desktop\project\vocab\service\logs</logpath>
  <log mode="reset"/>

  <onfailure action="restart" delay="10 sec"/>
  <resetfailure>1 hour</resetfailure>

  <stoptimeout>15 sec</stoptimeout>
</service>
